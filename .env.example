# Copy to .env.local and fill in. Never commit real values.
#
# DATABASE_URL and DATABASE_URL_UNPOOLED are written into .env automatically by
# the Neon CLI (`neon link`, `neon deploy`), so you normally do not set them by
# hand. They are listed here because Vercel needs them as environment variables.

# Neon Postgres, pooled connection (has "-pooler" in the host). Used at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Neon Postgres, direct connection (same host without "-pooler").
# Prisma uses this for migrations, which cannot run through the pooler.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Session/JWT signing key. Generate with: npx auth secret
AUTH_SECRET="generate-me"

# GitHub OAuth app credentials.
# Local:      callback http://localhost:3000/api/auth/callback/github
# Production: callback https://<project>.vercel.app/api/auth/callback/github
AUTH_GITHUB_ID="your-github-oauth-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-client-secret"
